{
  "name": "@toddynnn/voice-opus",
  "version": "2.0.0",
  "description": "Opus encoding, decoding and media probing for Node.js, with libopus 1.6.1",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "url": "git+https://github.com/ToddyTheNoobDud/toddynnn-voice.git",
    "type": "git"
  },
  "license": "MIT",
  "keywords": [
    "opus",
    "libopus",
    "audio",
    "codec",
    "napi-rs"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "napi": {
    "binaryName": "toddy-voice",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-linux-android",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-linux-androideabi",
      "riscv64gc-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "cargo fmt",
    "lint": "cargo clippy --all-targets --locked -- -D warnings",
    "test": "node --test __test__/codec.test.cjs",
    "bench": "node benchmark/codec.cjs",
    "version": "napi version",
    "prepack": "node scripts/prepare-release.cjs --check",
    "release:prepare": "napi create-npm-dirs && napi artifacts && node scripts/prepare-release.cjs",
    "release:check": "node scripts/prepare-release.cjs --check",
    "pack:preview": "npm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  },
  "type": "commonjs",
  "homepage": "https://github.com/ToddyTheNoobDud/toddynnn-voice#readme",
  "bugs": {
    "url": "https://github.com/ToddyTheNoobDud/toddynnn-voice/issues"
  }
}
